<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.itda.member.mapper.FollowingMapper">

    <!-- 특정 회원이 팔로우하는 사람들의 목록 조회 -->
    <select id="findFollowings"
            parameterType="Long"
            resultType="net.likelion.bebc25.itda.member.dto.FollowingResponse">

        SELECT
        m.id,
        m.nickname,
        m.profile_image
        FROM follow f
        JOIN member m
        ON f.to_id = m.id
        WHERE f.from_id = #{fromId}
        ORDER BY f.created_at DESC

    </select>

    <!-- 특정 회원의 팔로잉 수 조회 -->
    <select id="countFollowings" resultType="int">
        SELECT COUNT(*)
        FROM follow
        WHERE from_id = #{fromId}
    </select>

</mapper>