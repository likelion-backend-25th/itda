<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.itda.member.mapper.MemberInterestMapper">

    <insert id="insert">
        INSERT INTO member_interest (member_id, category_id)
        VALUES (#{memberId}, #{categoryId})
    </insert>

    <select id="findCategoryIdsByMemberId" resultType="long">
        SELECT category_id
        FROM member_interest
        WHERE member_id = #{memberId}
        ORDER BY id
    </select>

    <delete id="deleteByMemberId">
        DELETE FROM member_interest
        WHERE member_id = #{memberId}
    </delete>

</mapper>
