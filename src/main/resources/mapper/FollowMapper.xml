<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.itda.member.mapper.FollowMapper">

    <!-- 팔로우 여부 확인 -->
    <select id="existsFollow" resultType="int">
        SELECT COUNT(*)
        FROM follow
        WHERE from_id = #{fromId}
        AND to_id = #{toId}
    </select>

    <!-- 팔로우 -->
    <insert id="follow">
        INSERT INTO follow (from_id, to_id)
        VALUES (#{fromId}, #{toId})
    </insert>

    <!-- 언팔로우 -->
    <delete id="unfollow">
        DELETE FROM follow
        WHERE from_id = #{fromId}
        AND to_id = #{toId}
    </delete>

</mapper>