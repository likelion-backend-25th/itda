<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.itda.payment.mapper.PaymentMapper">

    <!--common_code 조회 -->
    <select id="findCommonCodeId" resultType="java.lang.Long">>
        SELECT id
        FROM common_code
        WHERE type = #{type}
        AND code = #{code}
        AND is_active = TRUE
    </select>

</mapper>